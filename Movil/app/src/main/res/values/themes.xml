<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.FichajeFX" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/primary_light</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:statusBarColor">@color/background_alt</item>
        <item name="android:navigationBarColor">@color/background_alt</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="materialButtonStyle">@style/Widget.FichajeFX.Button</item>
        <item name="textInputStyle">@style/Widget.FichajeFX.TextInput</item>
    </style>

    <style name="Theme.FichajeFX" parent="Base.Theme.FichajeFX" />

    <style name="Widget.FichajeFX.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.FichajeFX.Button.Success" parent="Widget.FichajeFX.Button">
        <item name="backgroundTint">@color/accent_success</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>

    <style name="Widget.FichajeFX.Button.Danger" parent="Widget.FichajeFX.Button">
        <item name="backgroundTint">@color/accent_danger</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>

    <style name="Widget.FichajeFX.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/border</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="Widget.FichajeFX.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/input_stroke_focus</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="TextAppearance.FichajeFX.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.FichajeFX.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.FichajeFX.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
